========== 测试用例 ==========
test3.3

========== 源程序 ==========
//定义一个函数的测试，输入一个数，结果加上7
int a = 1 ;

int sum(int,int);

main(){

    int N = read() ;

    a = sum(sum(3,4),N) ;
    write(a);

}

int sum(int sum_x,int sum_y){

    int result ;
    result = sum_x + sum_y ;

    return result ;

}

