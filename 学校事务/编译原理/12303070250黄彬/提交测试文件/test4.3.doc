\pard\f1 // \u19977?\u-28654?\u24402?\u20989?\u25968?\u-29693?\u29992?\u27979?\u-29739?3\u-230?\u-32079?\u24335?\u19978?\u27004?\u26799?\u-244?\u27604?\u22914?\u24050?\u30693?\u24635?\u20849?\u26377?15\u32423?\u21488?\u-27082?\par //\u19968?\u20010?\u20154?\u20174?\u22320?\u-26782?\u24320?\u22987?\u21487?\u20197?\u19968?\u27425?\u19978?\u19968?\u32423?\u21488?\u-27082?\u-244?\u20063?\u21487?\u20197?\u19968?\u27425?\u19978?\u20004?\u32423?\u21488?\u-27082?\par //\u26368?\u22810?\u21487?\u20197?\u19968?\u27425?\u19978?\u19977?\u32423?\u21488?\u-27082?\u-244?\u-29705?\u-27154?\u-244?\u19978?\u21040?15\u32423?\u26377?\u22810?\u23569?\u20013?\u19978?\u27004?\u26799?\u30340?\u26041?\u27861?\par //\u31243?\u24207?\u21487?\u20197?\u20351?\u29992?\u20498?\u25512?\u30340?\u26041?\u27861?\u26469?\u20889?\par //\u32467?\u26524?\u-230?1\u-244?2\u-244?4\u-244?7\u-244?13\u-244?24\u-244?44\u-244?81\u-244?149......\par int f(int);\par main()\par \{\par    int m;\par    m = read();\par    write(f(m));\par \par \}\par \par int f(int n) \{\par    int a,b,c;\par    if(n==1) \{\par \tab \tab return 1;\par \tab \}\par    else if(n==2) \{\par \tab \tab return 2;\par \tab \}\par    else if(n==3) \{\par \tab \tab return 4;\par \tab \}\par     a = f(n - 1);\par     b = f(n - 2);\par     c = f(n - 3);\par     return a + b + c;\par  \}\par
