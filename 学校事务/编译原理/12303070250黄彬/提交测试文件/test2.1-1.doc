\pard\f1 \par //if and while,\u-27082?\u20056?\par main()\par \{\par   int i,factor,n;\par   i=0;\par   n=read();\par   if(n<1)     \{\par       factor=0;\par     \}\par   else \{\par     factor=1;\par   \}\par   while(i<n)\par     \{\par       i=i+1;\par       factor=factor*i;\par     \}\par   write(factor);\par \}\par
