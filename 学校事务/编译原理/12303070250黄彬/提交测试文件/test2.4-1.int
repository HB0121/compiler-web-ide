========== 测试用例 ==========
test2.4-1

========== 源程序 ==========
//多重for测试，打印三角形
void main()
{
	int n=0,j=0,i=0;
	n = read();
	for(i=0;i<n;i=i+1)
	{
		for(j=0;j<n-i-1;j=j+1)
		{
			write(' ');	
		}
		for(j=0;j<i+1;j=j+1)
		{
			write('* ');
		}
		write('\n');
	}
}

