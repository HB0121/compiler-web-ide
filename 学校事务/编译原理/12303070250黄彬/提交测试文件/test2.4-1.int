    MOV ss:[bp-6],AX
    JMP far ptr _7
_12:
    MOV AX,0
    MOV ss:[bp-4],AX
_13:
    MOV AX,ss:[bp-2]
    SUB AX,ss:[bp-6]
    MOV ss:[bp-12],AX
    MOV AX,ss:[bp-12]
    SUB AX,1
    MOV ss:[bp-14],AX
    MOV AX,ss:[bp-4]
    CMP AX,ss:[bp-14]
    JL _20
    JMP far ptr _23
_17:
