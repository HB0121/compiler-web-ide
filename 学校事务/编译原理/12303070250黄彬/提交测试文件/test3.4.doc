\pard\f1 //\u23450?\u20041?\u20004?\u20010?\u20989?\u25968?\u30340?\u27979?\u-29739?\u-244?\u-28781?\u20837?\u20004?\u20010?\u25968?\u-244?\u23558?\u20854?\u20013?\u-28797?\u22823?\u30340?\u25968?\u21152?100\u-28781?\u20986?\u-244?\u27492?\u20989?\u25968?\u-26880?\u-30335?\u-28709?\u19968?\u27493?\u27979?\u-29739?\u21516?\u21517?\u21464?\u-28209?\u30340?\u20351?\u29992?\par int a = 1 ;\par \par int sum(int,int);\par int max(int,int);\par main()\{\par \par     int N = read() ;\par     int M = read() ;\par     a = sum(max(M,N),100) ;\par     write(a);\par \par \}\par \par int sum(int sum_x,int sum_y)\{\par \par     int result ;\par     result = sum_x + sum_y ;\par \par     return result ;\par \par \}\par \par int max(int m_x,int m_y)\{\par \par     int result ;\par     if (m_x >= m_y)result = m_x ;\par \tab else result = m_y;\par     return result ;\par \par \}\par
\pard\b \u25191?\u-30644?\u32467?\u26524?\u25688?\u-30335?\b0\par
\pard\f1 Execution Result\par Item | Value | Meaning\par --- | --- | ---\par return_value | None | \u31243?\u24207?\u26368?\u32456?\u-28716?\u22238?\u20540?\par \par Variables\par Name | Value\par --- | ---\par M | 0\par N | 0\par a | 100\par t1 | 0\par t2 | 0\par t3 | 0\par t4 | 100\par t5 | 0\par \par Execution Trace\par Step | Quad / Event | Meaning\par --- | --- | ---\par 1 | 0: global (=, 1, _, a) | a = 1\par 2 | 2: (call, read, _, t1) | \u-29693?\u29992?\u20989?\u25968? read\u-244?\u32467?\u26524?\u20445?\u23384?\u21040? t1\par 3 | builtin read() -> 0 | \u27169?\u25311?\u20869?\u32622?\u-28781?\u20837?\u20989?\u25968? read\u-244?\u-24872?\u-29788?\u-29701?\u20837? 0\par 4 | 3: (=, t1, _, N) | N = t1\par 5 | 4: (call, read, _, t2) | \u-29693?\u29992?\u20989?\u25968? read\u-244?\u32467?\u26524?\u20445?\u23384?\u21040? t2\par 6 | builtin read() -> 0 | \u27169?\u25311?\u20869?\u32622?\u-28781?\u20837?\u20989?\u25968? read\u-244?\u-24872?\u-29788?\u-29701?\u20837? 0\par 7 | 5: (=, t2, _, M) | M = t2\par 8 | 6: (para, M, _, _) | \u20934?\u22791?\u20989?\u25968?\u21442?\u25968? M\par 9 | 7: (para, N, _, _) | \u20934?\u22791?\u20989?\u25968?\u21442?\u25968? N\par 10 | 8: (call, max, _, t3) | \u-29693?\u29992?\u20989?\u25968? max\u-244?\u32467?\u26524?\u20445?\u23384?\u21040? t3\par 11 | call max(0, 0) | \u-29693?\u29992?\u29992?\u25143?\u-32278?\u23450?\u20041?\u20989?\u25968?\par 12 | 22: fn (J>=, m_x, m_y, 24) | \u26465?\u20214?\u25104?\u31435?\u26102?\u-29197?\u-28820?\u21040?\u22235?\u20803?\u24335? 24\par 13 | 24: fn (=, m_x, _, result) | result = m_x\par 14 | 25: fn (J, _, _, 27) | \u26080?\u26465?\u20214?\u-29197?\u-28820?\u21040?\u22235?\u20803?\u24335? 27\par 15 | 27: fn (ret, _, _, result) | \u-28716?\u22238? result\par 16 | 9: (para, t3, _, _) | \u20934?\u22791?\u20989?\u25968?\u21442?\u25968? t3\par 17 | 10: (para, 100, _, _) | \u20934?\u22791?\u20989?\u25968?\u21442?\u25968? 100\par 18 | 11: (call, sum, _, t4) | \u-29693?\u29992?\u20989?\u25968? sum\u-244?\u32467?\u26524?\u20445?\u23384?\u21040? t4\par 19 | call sum(0, 100) | \u-29693?\u29992?\u29992?\u25143?\u-32278?\u23450?\u20041?\u20989?\u25968?\par 20 | 17: fn (+, sum_x, sum_y, t6) | t6 = sum_x + sum_y\par 21 | 18: fn (=, t6, _, result) | result = t6\par 22 | 19: fn (ret, _, _, result) | \u-28716?\u22238? result\par 23 | 12: (=, t4, _, a) | a = t4\par 24 | 13: (para, a, _, _) | \u20934?\u22791?\u20989?\u25968?\u21442?\u25968? a\par 25 | 14: (call, write, _, t5) | \u-29693?\u29992?\u20989?\u25968? write\u-244?\u32467?\u26524?\u20445?\u23384?\u21040? t5\par 26 | builtin write(100) | \u27169?\u25311?\u20869?\u32622?\u-28781?\u20986?\u20989?\u25968? write\par 27 | 15: (sys, _, _, _) | \u31243?\u24207?\u32467?\u26463?\par \par Runtime Warnings\par Warning\par ---\par None\par
