    JMP far ptr _21
_15:
    MOV AX,ss:[bp-2]
    CMP AX,ss:[bp-4]
    JG _17
    JMP far ptr _18
_17:
    MOV AX,ss:[bp-2]
    MOV ss:[bp-4],AX
_18:
    MOV AX,ss:[bp-2]
    CMP AX,ss:[bp-6]
    JL _20
    JMP far ptr _21
_20:
    MOV AX,ss:[bp-2]
    MOV ss:[bp-6],AX
_21:
    MOV AX,ss:[bp-8]
    ADD AX,ss:[bp-2]
    MOV ss:[bp-14],AX
    MOV AX,ss:[bp-14]
    MOV ss:[bp-8],AX
    MOV AX,ss:[bp-10]
    ADD AX,1
    MOV ss:[bp-16],AX
    MOV AX,ss:[bp-16]
    MOV ss:[bp-10],AX
    JMP far ptr _6
_26:
    ; builtin write(): string '最大 最小 平均值：'
    CALL write
