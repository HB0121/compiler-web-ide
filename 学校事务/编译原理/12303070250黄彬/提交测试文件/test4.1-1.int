========== 测试用例 ==========
test4.1-1

========== 源程序 ==========
//递归函数调用的测试1，求阶乘，测试两个函数是否限定了需要使用不同的变量名m和n
//使用int类型，值要小于65536
//输入值n<=8
int factor(int);
main()
{
  int n;
  n=read();
  write(factor(n));
}

int factor(int m) {
  int fa;
  if(m<=1) {
    fa=1;
  }
  else{
    fa=m*factor(m-1);
  }
  return fa;
}

