========== 测试用例 ==========
test2.4-2

========== 源程序 ==========
//双重for循环测试，求给定数以内的素数

main(){

    int N = read() ;
    int count=0,nprime=0,i,j;
    for(i=2;i<=N;i=i+1) {
       nprime = 0;
       for(j=2;j<i;j=j+1) {
	   if(i%j == 0) nprime = nprime + 1;
       }
       if(nprime == 0) {
            write(i);
            count = count + 1;
        }
     }

}

