========== 测试用例 ==========
test2.3

========== 源程序 ==========
//while嵌套if测试，求给定数以内所有偶数的和
int a = 1 ;

main(){

    int i = 1,sum=0,N ;
    N = read();

    while(i < N){
       if(i%2 == 0){
           sum = sum +i;
       }
       i = i + 1;
    }
    write(sum);
}

