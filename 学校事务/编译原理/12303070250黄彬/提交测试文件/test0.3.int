========== 源程序 ==========
//关系表达式
main() {
       int x = 1;
       int y = -2
       int a, b, c, d;
       a = x > y;
       b = x < y;
       c = x == y;
       d = x != y;
       write(a);
       write(b);
       write(c);
       write(d);
       }

