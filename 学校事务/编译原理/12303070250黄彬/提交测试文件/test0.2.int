test0.2

========== 源程序 ==========
//布尔表达式
main() {
       int x = 2;
       int y = 3;
       int a, b, c, d;
       a = x && y;
       b = x && 0;
       c = x || y;
       d = x || 0;
       write(a);
       write(b);
       write(c);
       write(d);
       }

