========== 测试用例 ==========
test1.1-3

========== 源程序 ==========
// 测试if语句中含有多个条件表达式
main()
{
   int m,k,result;
   result = 666;
   m = read();
   k = read();
   if(m < k || m != 0 &&k == 1)
        write(result);
}

