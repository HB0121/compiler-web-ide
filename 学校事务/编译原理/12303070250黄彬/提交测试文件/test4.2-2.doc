\pard\f1 // \u21452?\u-28654?\u24402?\u20989?\u25968?\u-29693?\u29992?\u27979?\u-29739?2\u-230?\u-29791?\u31639?\u32452?\u21512?\u25968?\par int comp(int,int);\par main()\par \{\par    int m,k,result;\par    m = read();\par    k = read();\par    result = comp(m,k);\par    write(result);\par \}\par \par int comp(int n,int i) \{\par int a, b; \par if(n == i || i == 0)\par \tab \{\par \tab \tab return 1;\par \tab \}\par \tab  a = comp(n-1,i) ;\par                  b = comp(n-1,i-1);\par \tab return a + b ; \par \}\par
