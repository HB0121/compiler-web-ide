========== 测试用例 ==========
test1.4

========== 源程序 ==========
//do while语句测试，求1到10的数字之和
main(){
  int x;
  int sum = 0;

  x = 1;
 do {
      sum = sum + x;
      x = x + 1;
     } while (x <= 10)；
  write(x);
  write(sum);
}

